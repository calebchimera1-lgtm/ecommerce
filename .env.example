# =====================================================================
# Kymera Collection - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env
# =====================================================================

APP_NAME="Kymera Collection"
APP_ENV=local
# APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost/kymera-collection
APP_TIMEZONE=Africa/Nairobi
APP_KEY=                     # 32-byte random key, used for encryption. Generate with bin2hex(random_bytes(32))

# ---------------------------------------------------------------------
# Database (MySQL 8 / XAMPP default)
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kymera_collection
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------
# Mail (PHPMailer / SMTP)
# ---------------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@kymeracollection.com
MAIL_FROM_NAME="Kymera Collection"

# ---------------------------------------------------------------------
# Session / Security
# ---------------------------------------------------------------------
SESSION_NAME=kymera_session
SESSION_LIFETIME=120
CSRF_TOKEN_NAME=kymera_csrf_token
HASH_ALGO=PASSWORD_ARGON2ID
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15

# ---------------------------------------------------------------------
# Payment Gateways (abstracted - see app/Services/Payment)
# Leave blank until you have real sandbox/live credentials.
# ---------------------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY=cod

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# M-Pesa (Daraja API)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ---------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ---------------------------------------------------------------------
# Third-party
# ---------------------------------------------------------------------
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
